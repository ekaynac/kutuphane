# llmdap-bridge settings for the Kütüphane compose. Copy to bridge.env (git-ignored) and fill the two keys.
LLMDAP_POLICY=@/etc/llmdap/policy.csv
# openssl genpkey -algorithm ed25519 | base64 -w0
LLMDAP_AUDIT_KEY=<BASE64_ED25519_PKCS8_PEM>
# openssl rand -hex 32
LLMDAP_BRIDGE_DIGEST_KEY=<RANDOM_32_PLUS_CHARS>
GATEWAY_AUTH_MODE=subject-keys
GATEWAY_SUBJECT_KEYS_FILE=/etc/llmdap/keys.json

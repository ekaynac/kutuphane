# Copy to .env (git-ignored) and fill in. Secrets go only in .env. Every setting: docs/guide/operations.md.

# The release tag of the Kütüphane image that compose runs, for example v1.0.0. Required; there is no `latest`.
# With compose.build.yaml (build from this checkout) set it to `dev`.
KUTUPHANE_VERSION=

# Postgres owner and app role passwords (docs/guide/install.md, "Database roles").
KUTUPHANE_DB_PASSWORD=
KUTUPHANE_APP_DB_PASSWORD=

# The URL that clients use for the ingress proxy, and the OIDC issuer exactly as tokens carry it.
KUTUPHANE_PUBLIC_URL=
KUTUPHANE_OIDC_ISSUER=
# Absolute path of the JWKS file (default deploy/jwks.json).
#KUTUPHANE_OIDC_JWKS_FILE=

# Only with `--profile publisher` (docs/guide/operations.md, "Publisher service"): the file that holds the owner
# credential (KUTUPHANE_CURATOR_DSN and KUTUPHANE_WEBAUTHN_*). Keep it outside the checkout, mode 600. No value here.
#KUTUPHANE_PUBLISHER_ENV_FILE=
# Seconds between two runs of `imports publish-admitted` (default 60).
#KUTUPHANE_PUBLISH_INTERVAL=

# Only if you change the standalone embedder (docs/guide/operations.md, "Standalone embedder"). Compose settings.
#KUTUPHANE_EMBEDDER_THREADS=4
#KUTUPHANE_EMBEDDER_MEMORY=6g
# No model server (full text search only): both `llmdap`, and `--scale embedder=0 --scale models-fetch=0` at every `up`.
#KUTUPHANE_EMBED_PROVIDER=llmdap
#KUTUPHANE_RERANK_PROVIDER=llmdap
# The answer model: an OpenAI-compatible server (the key is a secret; Core needs a network path to it).
#KUTUPHANE_ANSWER_PROVIDER=openai
#KUTUPHANE_ANSWER_OPENAI_URL=
#KUTUPHANE_ANSWER_OPENAI_KEY=
#KUTUPHANE_ANSWER_OPENAI_CLASS=
#KUTUPHANE_ANSWER_MODEL=
